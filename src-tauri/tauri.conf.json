{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Farside",
  "version": "1.0.7",
  "identifier": "com.shivamtaneja.farside",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Farside",
        "width": 900,
        "height": 700,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://tauri-update-server.codesbyshivam.workers.dev/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQjVFOTc2RUM0RkE5RDEKUldUUnFVL3NkdW0xei9WL0lpTnBHUDU4bzJYV2tDbU0yK0kyOS94d0M3N3VZKzB5N29UR1J1L2IK"
    }
  }
}
